    "rest": {
      "rights": "POST /piaogen-mcp/rights",
      "plan": "POST /piaogen-mcp/plan",
      "manifest": "GET /piaogen-mcp/manifest.json",
      "openapi": "GET /piaogen-mcp/openapi.json"
    },
    "local": {
      "stdio": "node mcp/server.js",
      "http": "node mcp/http-server.js"
    }
  },
  "inputs": {
    "product": "商品名，例如「空调」",
    "amount": "购买金额",
    "date": "购买日期 YYYY-MM-DD",
    "receivedDate": "签收日期；线上 7 天无理由从这天算",
    "invoiceDate": "发票日期；三包从这天算",
    "channel": "taobao / jd / alipay / offline 等",
    "currentPrice": "当前同款价格；有价保时用来算差价",
    "today": "按哪天算，默认今天"
  },
  "outputs": ["windows", "nearest", "evidenceGaps", "next", "materials", "official", "doNot"],
  "boundaries": [
    "不代提交任何投诉或申请",
