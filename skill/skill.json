  "tags": ["消费维权", "退货换货", "价保", "保修", "自动续费", "预付卡", "保险犹豫期", "拒付"],
  "capabilities": {
    "mcp": {
      "transport": "http-json-rpc",
      "endpoint": "https://xiongxiongkaifa-d4flmaia4021b1d1-1506832756.ap-shanghai.app.tcloudbase.com/piaogen-mcp",
      "mode": "read-only",
      "tools": ["rights.lookup", "rights.plan", "policy.parse", "finance.lookup", "finance.plan"]
